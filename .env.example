# Infrastructure
POSTGRES_DB=forgeai
POSTGRES_USER=forgeai
POSTGRES_PASSWORD=change-me
DATABASE_URL=jdbc:postgresql://postgres:5432/forgeai
REDIS_URL=redis://redis:6379

# Optional platform-funded credentials. ForgeAI runs in BYOK-only mode when absent.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=replace-with-32-random-bytes
FORGEAI_INTERNAL_TOKEN=replace-with-32-random-bytes

# Browser/API boundaries
ALLOWED_ORIGINS=http://localhost:8080
DEMO_DAILY_QUOTA=5
GATEWAY_URL=http://gateway:8080
AUTOPR_URL=http://autopr:8000

# Optional Grafana Cloud OTLP/Prometheus integration
GRAFANA_CLOUD_URL=
GRAFANA_CLOUD_TOKEN=
